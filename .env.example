# Copiar a .env y completar. El .env está en .gitignore y nunca se sube al repositorio.

# Pinecone — clave gratuita en https://app.pinecone.io
PINECONE_API_KEY=

# Embeddings — Google AI Studio: https://aistudio.google.com/apikey
# El proyecto usa gemini-embedding-001 con output_dimensionality=1536.
GOOGLE_API_KEY=

# Nombre del índice. Cambiarlo crea un índice aparte: sirve para levantar uno de staging
# sin tocar el de siempre.
INDEX_NAME=pydantic-docs-rag

# Namespace dentro del índice. Aísla este corpus de cualquier otro que comparta el índice.
PINECONE_NAMESPACE=pydantic-concepts-v1

# Región del índice serverless. La capa gratuita de Pinecone solo admite aws/us-east-1.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1
